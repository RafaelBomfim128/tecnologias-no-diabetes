{
  "name": "diabetes-sites-redirect",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "env NODE_ENV=development node src/main.js",
    "read_only": "env NODE_ENV=read_only node src/main.js",
    "serve-site": "npx kill-port 8080 && http-server public -p 8080 --silent",
    "test:jest": "jest",
    "test:jest:coverage": "jest --coverage",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:html": "cypress run --reporter mochawesome",
    "test:e2e-only": "wait-on http://localhost:8080 && cypress run",
    "e2e:serve": "npm-run-all --parallel --race serve-site test:e2e-only",
    "test:build-e2e": "npm run dev && npm run e2e:serve"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "googleapis": "^149.0.0",
    "handlebars": "^4.7.8",
    "pdf-to-png-converter": "^3.6.5",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "cypress": "^14.5.0",
    "cypress-delete-downloads-folder": "^0.0.6",
    "cypress-mochawesome-reporter": "^3.8.2",
    "http-server": "^14.1.1",
    "jest": "^30.0.0",
    "kill-port": "^2.0.1",
    "npm-run-all": "^4.1.5",
    "wait-on": "^8.0.3"
  }
}
